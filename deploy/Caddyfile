# HTTPS-домен для Mini App. DOMAIN берётся из .env (A-запись домена должна указывать на сервер до первого запуска).
{$DOMAIN} {
	encode zstd gzip

	# Фото показаний — до ~12 МБ; всё остальное мелкое. Сервер дополнительно ограничивает тело запроса.
	request_body {
		max_size 13MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# Mini App открывается только внутри Telegram
		Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org"
	}

	# Статика (собранный Svelte) и API отдаёт один процесс rentflow
	reverse_proxy rentflow:8080
}
