# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=123456:replace-me

# Устарело (v0.3): права владельца теперь берутся из базы (membership), владельцы регистрируются сами.
# Значение используется только как получатель алертов, если не задан ADMIN_TELEGRAM_ID. Можно не задавать.
# LANDLORD_TELEGRAM_ID=

# Ключ Anthropic для распознавания фото (необязательно: без него показания вводятся вручную)
ANTHROPIC_API_KEY=
# Модель для распознавания (по умолчанию claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# База SQLite и оригиналы фото
DATABASE_URL=sqlite://data/rentflow.db
PHOTO_DIR=data/photos

# Часовой пояс как сдвиг от UTC в часах (Москва = 3). По нему определяется расчётный месяц.
TZ_OFFSET_HOURS=3

# --- Mini App ---
# Домен, на котором Caddy выдаст HTTPS-сертификат (A-запись должна вести на сервер). Нужен docker compose.
DOMAIN=rentflow.example.com
# Полный адрес приложения — он станет кнопкой меню бота (то же, что Menu Button в BotFather). Без него кнопку задайте вручную.
MINIAPP_URL=https://rentflow.example.com
# Куда слушает встроенный HTTP API (в Docker уже 0.0.0.0:8080; наружу порт не публикуется — его проксирует Caddy)
# HTTP_BIND=127.0.0.1:8080
# Каталог собранного фронтенда (в Docker уже /app/web). Локально: WEB_DIR=web/dist
# WEB_DIR=web/dist

# Срок действия ссылки-приглашения, дней
INVITE_TTL_DAYS=7

# Подробность логов: info | debug
RUST_LOG=info,sqlx=warn

# --- Если api.telegram.org недоступен из вашей сети (ошибка HandshakeFailure / timeout) ---
# Прокси для всех запросов бота (VPN-клиент обычно поднимает локальный прокси):
# HTTPS_PROXY=socks5h://127.0.0.1:1080   (socks5h: имя разрешает сам прокси — надёжнее при подмене DNS)
# или http://127.0.0.1:8080
# Либо свой адрес Bot API (зеркало / обратный прокси):
# TELEGRAM_API_URL=https://telegram-api.example.com

# --- Мониторинг и резервные копии (v0.3) ---
# Кто получает алерты (Telegram ID администратора сервиса). Прав на данные пользователей не даёт.
# ADMIN_TELEGRAM_ID=
# Аннулирование ОПЛАЧЕННЫХ счетов выключено; 1 включает — только для тестовых данных
# ALLOW_VOID_PAID=0
# Выгрузка копий за пределы сервера (deploy/backup-offsite.sh): включает проверку «копия не старше 36 ч»
# OFFSITE_EXPECTED=1
# BACKUP_REMOTE=hetzner-box:rentflow
# AGE_RECIPIENT=age1...
# BACKUP_RETENTION_DAYS=30
