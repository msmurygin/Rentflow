# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=123456:replace-me

# Ваш числовой Telegram-ID — единственный владелец, кто может настраивать объект и утверждать счета.
# Не знаете ID? Запустите бот с LANDLORD_TELEGRAM_ID=0, напишите ему /whoami, впишите число сюда и перезапустите.
LANDLORD_TELEGRAM_ID=0

# Ключ Anthropic для распознавания фото (необязательно: без него показания вводятся вручную)
ANTHROPIC_API_KEY=
# Модель для распознавания (по умолчанию claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# База SQLite и оригиналы фото
DATABASE_URL=sqlite://data/rentflow.db
PHOTO_DIR=data/photos

# Часовой пояс как сдвиг от UTC в часах (Москва = 3). По нему определяется расчётный месяц.
TZ_OFFSET_HOURS=3

# Срок действия ссылки-приглашения, дней
INVITE_TTL_DAYS=7

# Подробность логов: info | debug
RUST_LOG=info,sqlx=warn
